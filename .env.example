# NAS directory owner for ./data and the selected media directory.
PUID=1000
PGID=1000

# TCP port exposed by the NAS host.
MUJING_HOST_PORT=48291
MUJING_SERVER_NAME=幕境 NAS

# Optional. Set this once the NAS host LAN address is stable. It is used only
# as an advertised connection/QR endpoint and is never inferred from Docker.
# Example: http://192.168.1.20:48291
MUJING_ADVERTISE_URL=

# Required to create pairing sessions. Keep this only in the untracked .env,
# never in source control. Android omits requestedScope and receives viewer;
# the Windows management client explicitly requests admin.
MUJING_PAIRING_CODE=

# This is the only switch read by `sh bin/mujing-compose`. It chooses one
# complete and repeatable bind-mount layout for every start/restart. The
# default is read-only dual media disks. See README for every allowed value.
MUJING_DEPLOYMENT_MODE=dual

# Optional test-only media file, relative to the container media root (/media).
# 路径不得包含绝对路径、`.` 或 `..` 段。默认 dual 部署会在下方以
# disk1/ 或 disk2/ 前缀表示。
# MUJING_FIXTURE_MEDIA_RELATIVE_PATH=disk1/Movies/sample.mp4

# The default /media overlay is a read-only boundary. New deployments do not
# scan on startup: create a category and bind a child directory from the Windows
# NAS management page, then scan that category explicitly.
# MUJING_SCAN_ON_START is retained only for isolated legacy tests and ignored
# by environment-based deployments.
MUJING_MEDIA_ROOT_NAME=媒体库
MUJING_SCAN_ON_START=false
MUJING_TIMEZONE=Asia/Shanghai

# Writable managed TXT library. NOVEL_ROOT is the NAS host directory mounted
# at /novels. Leave MUJING_NOVEL_QUOTA_BYTES empty for unlimited logical usage.
NOVEL_ROOT=./novels
MUJING_NOVEL_QUOTA_BYTES=
MUJING_MAX_NOVEL_UPLOAD_BYTES=67108864
MUJING_NOVEL_UPLOAD_CONCURRENCY=1
MUJING_NOVEL_UPLOAD_REQUESTS_PER_MINUTE=30

# Writable comic library on a persistent NAS volume. Catalog metadata lives
# beside the original ZIP/CBZ/PDF objects, so restoring /data does not erase it.
COMIC_ROOT=./comics
MUJING_COMIC_QUOTA_BYTES=
MUJING_MAX_COMIC_UPLOAD_BYTES=2147483648
MUJING_MAX_COMIC_CHUNK_BYTES=67108864

# Optional MDCNG actor import source. Set MDCNG_DATA_ROOT and choose an
# *-mdcng deployment mode. The selected mode mounts only MDCNG's config/data
# directory read-only; never mount its config.json. MUJING_MDCNG_DATA_DIR is
# set by the selected Compose overlay and must not be entered here.
# MUJING_MDCNG_SOURCE_ID=emby-n150
# MDCNG_DATA_ROOT=/vol2/1000/docker/mdcng-test/config/data

# Production default: retain warnings and errors without recording every
# request and stream event. Set INFO temporarily while diagnosing an issue.
MUJING_LOG_LEVEL=WARN
MUJING_DIAGNOSTIC_MODE=false
MUJING_LOG_MAX_BYTES=2097152
MUJING_LOG_RETENTION_FILES=3

# 仅在明确选择单盘只读媒体覆盖时需要设置。该目录必须已存在，服务不会
# 创建或猜测其路径。
# MEDIA_ROOT=/vol1/media

# 默认真实媒体部署使用 MUJING_DEPLOYMENT_MODE=dual，不要同时设置或挂载单盘 MEDIA_ROOT。
# 容器内会分别显示为 /media/disk1 和 /media/disk2；Windows 类别目录相应填写
# disk1/子目录 或 disk2/子目录。测试文件路径也必须加上盘前缀。
# MEDIA_ROOT_DISK1=/vol2/1000/first movies
# MEDIA_ROOT_DISK2=/vol1/1000/second movies
# MUJING_FIXTURE_MEDIA_RELATIVE_PATH=disk1/动漫/样片.mp4

# Optional high-risk opt-in. This must be true only with a *-writable
# MUJING_DEPLOYMENT_MODE; the launcher rejects every other combination.
# It only permits validated in-place episode renames.
MUJING_ALLOW_SOURCE_RENAME=false
